	partition fact_eco = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_eco.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Selected Columns" = Table.SelectColumns(#"Promoted Headers", {"tournament", "stage", "match_type", "match_name", "map", "team", "buy_category", "initiated", "won"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Selected Columns", {{"tournament", type text}, {"stage", type text}, {"match_type", type text}, {"match_name", type text}, {"map", type text}, {"team", type text}, {"buy_category", type text}, {"initiated", type number}, {"won", type number}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
