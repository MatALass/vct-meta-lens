table fact_agent_picks
	lineageTag: d4f275a9-0a6d-5e79-acda-5c72b2d52aea

	/// Pick rate pondéré par le nombre de maps jouées (jamais une moyenne simple des pourcentages).
	measure 'Pick rate %' =
			DIVIDE (
			    SUMX ( fact_agent_picks, fact_agent_picks[pick_rate] * fact_agent_picks[maps_played] ),
			    SUM ( fact_agent_picks[maps_played] )
			) / 100
		formatString: 0.0%
		displayFolder: Méta agents
		lineageTag: 1ce3d000-f9d9-50a1-b92b-e028a92b13eb

	measure 'Agents joués' = CALCULATE ( DISTINCTCOUNT ( fact_agent_picks[agent] ), fact_agent_picks[pick_rate] > 0 )
		formatString: 0
		displayFolder: Méta agents
		lineageTag: 4250f6df-8c15-5191-8877-0b66edd81637

	column tournament
		dataType: string
		isHidden
		lineageTag: 29640236-27fc-5565-a5e6-ad51046c353f
		summarizeBy: none
		sourceColumn: tournament

		annotation SummarizationSetBy = Automatic

	column stage
		dataType: string
		lineageTag: 5a7032ac-0d8d-5dd3-8ed8-2c4a6596c9d5
		summarizeBy: none
		sourceColumn: stage

		annotation SummarizationSetBy = Automatic

	column match_type
		dataType: string
		lineageTag: 8e05835b-8d12-506e-92d1-e11511f70156
		summarizeBy: none
