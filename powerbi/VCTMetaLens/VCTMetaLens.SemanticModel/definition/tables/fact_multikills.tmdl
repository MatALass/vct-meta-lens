table fact_multikills
	lineageTag: e515f8e6-dde1-537d-9c6a-95a06b79b0ef

	measure 'Clutchs gagnés' =
			SUM ( fact_multikills[1v1] ) + SUM ( fact_multikills[1v2] ) + SUM ( fact_multikills[1v3] )
			    + SUM ( fact_multikills[1v4] ) + SUM ( fact_multikills[1v5] )
		formatString: #,0
		displayFolder: Duels
		lineageTag: 3b0bc92b-f6d5-5f34-b8c3-5ccd8ca088fd

	measure 'Clutchs 1v3+' = SUM ( fact_multikills[1v3] ) + SUM ( fact_multikills[1v4] ) + SUM ( fact_multikills[1v5] )
		formatString: #,0
		displayFolder: Duels
		lineageTag: 333b1007-6c27-529e-8bc2-a31f6a1544be

	/// Une ligne de fact_multikills = un joueur sur une map.
	measure 'Clutchs par map' = DIVIDE ( [Clutchs gagnés], COUNTROWS ( fact_multikills ) )
		formatString: 0.00
		displayFolder: Duels
		lineageTag: 421c32e0-3c60-57df-88dd-04f9273c0347

	measure 'Multikills 2K' = SUM ( fact_multikills[2k] )
		formatString: #,0
		displayFolder: Duels
		lineageTag: a8f59cb9-ffa8-5534-8cfb-e12eddba21c9

	measure 'Multikills 3K' = SUM ( fact_multikills[3k] )
		formatString: #,0
		displayFolder: Duels
		lineageTag: a61d740f-57ce-573d-98ed-9db6e8050d3a

	measure 'Multikills 4K' = SUM ( fact_multikills[4k] )
		formatString: #,0
		displayFolder: Duels
		lineageTag: 2f31e651-4f40-528c-beb9-d79c289915ea

	measure Aces = SUM ( fact_multikills[5k] )
		formatString: #,0
		displayFolder: Duels
		lineageTag: 0fa88739-b9a2-507d-b781-cf3d4ea65c78

	measure 'Multikills 3K+' = [Multikills 3K] + [Multikills 4K] + [Aces]
		formatString: #,0
		displayFolder: Duels
		lineageTag: bb58c442-8279-5ddf-8b1b-7159002ee649

	measure 'Spikes plantés' = SUM ( fact_multikills[spike_plants] )
		formatString: #,0
		displayFolder: Duels
		lineageTag: 3d6d45c9-56b4-54a0-b2c4-06dbbe8cb420

	measure 'Spikes désamorcés' = SUM ( fact_multikills[spike_defuses] )
		formatString: #,0
		displayFolder: Duels
		lineageTag: 9cb0f49d-30e5-58de-9b08-cbe05fac6a27

