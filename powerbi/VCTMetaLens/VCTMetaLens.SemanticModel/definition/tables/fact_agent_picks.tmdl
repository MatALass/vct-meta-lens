		annotation SummarizationSetBy = Automatic

	column map
		dataType: string
		isHidden
		lineageTag: b1dc0759-fe97-5435-bd83-2268876c2dd8
		summarizeBy: none
		sourceColumn: map

		annotation SummarizationSetBy = Automatic

	column agent
		dataType: string
		isHidden
		lineageTag: 1726e502-731b-55cb-91fb-ffb0414c3f41
		summarizeBy: none
		sourceColumn: agent

		annotation SummarizationSetBy = Automatic

	column pick_rate
		dataType: double
		isHidden
		lineageTag: 7540c6e6-4e95-5852-b480-57a2fc315b2a
		summarizeBy: sum
		sourceColumn: pick_rate

		annotation SummarizationSetBy = Automatic

	column maps_played
		dataType: int64
		isHidden
		lineageTag: 60e661b3-a8bf-5b29-a63e-06e0d030710b
		summarizeBy: sum
		sourceColumn: maps_played

		annotation SummarizationSetBy = Automatic

	partition fact_agent_picks = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_agent_picks.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Selected Columns" = Table.SelectColumns(#"Promoted Headers", {"tournament", "stage", "match_type", "map", "agent", "pick_rate", "maps_played"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Selected Columns", {{"tournament", type text}, {"stage", type text}, {"match_type", type text}, {"map", type text}, {"agent", type text}, {"pick_rate", type number}, {"maps_played", Int64.Type}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
