table fact_map_score
	lineageTag: 25b572dc-79bd-5bfc-90fe-efaf4006fbfb

	measure 'Maps (scores)' = COUNTROWS ( fact_map_score )
		formatString: #,0
		displayFolder: Maps
		lineageTag: ec00b2b8-c9f4-520e-9ae1-b72cd6f00616

	measure 'Durée moyenne (min)' = AVERAGE ( fact_map_score[duration_seconds] ) / 60
		formatString: 0.0
		displayFolder: Maps
		lineageTag: e19f68da-096a-55d3-af1d-d2b8a74fa455

	/// Part des maps allées en prolongation (au moins un round d'overtime).
	measure 'Prolongations %' =
			DIVIDE (
			    COUNTROWS (
			        FILTER (
			            fact_map_score,
			            fact_map_score[team_a_overtime_score] + fact_map_score[team_b_overtime_score] > 0
			        )
			    ),
			    [Maps (scores)]
			)
		formatString: 0.0%
		displayFolder: Maps
		lineageTag: 7d467a8c-3dac-5165-879d-6341055a54c1

	measure 'Écart de score moyen' = AVERAGEX ( fact_map_score, ABS ( fact_map_score[team_a_score] - fact_map_score[team_b_score] ) )
		formatString: 0.0
		displayFolder: Maps
		lineageTag: 9766fedf-7c91-5c2d-b040-b372015769e2

	measure 'Rounds par map' = AVERAGEX ( fact_map_score, fact_map_score[team_a_score] + fact_map_score[team_b_score] )
		formatString: 0.0
		displayFolder: Maps
		lineageTag: c41b8beb-479b-59c2-9e71-6b95437d750c

