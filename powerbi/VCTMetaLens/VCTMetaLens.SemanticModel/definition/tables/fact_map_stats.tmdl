table fact_map_stats
	lineageTag: 3fc2cdb9-c906-561d-a75f-4448179dc3b9

	measure 'Maps jouées' = SUM ( fact_map_stats[total_maps_played] )
		formatString: #,0
		displayFolder: Maps
		lineageTag: f7cadfbd-d6de-561b-b930-2789698bc5a2

	measure 'Winrate attaque %' =
			DIVIDE (
			    SUMX ( fact_map_stats, fact_map_stats[attacker_side_win_percentage] * fact_map_stats[total_maps_played] ),
			    [Maps jouées]
			) / 100
		formatString: 0.0%
		displayFolder: Maps
		lineageTag: e56374af-9158-5c0e-bf28-ad43a2404ae7

	measure 'Winrate défense %' =
			DIVIDE (
			    SUMX ( fact_map_stats, fact_map_stats[defender_side_win_percentage] * fact_map_stats[total_maps_played] ),
			    [Maps jouées]
			) / 100
		formatString: 0.0%
		displayFolder: Maps
		lineageTag: 3c480ade-370d-5bb5-b0bc-37d648769f4f

	measure 'Écart DEF - ATK (pts)' = ( [Winrate défense %] - [Winrate attaque %] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Maps
		lineageTag: ddbd593d-c6a7-5139-8303-54c7d3549e13

	column tournament
		dataType: string
		isHidden
		lineageTag: 5fad6f5d-ff81-50bb-84af-13fc25e07278
		summarizeBy: none
		sourceColumn: tournament

		annotation SummarizationSetBy = Automatic

	column stage
		dataType: string
		lineageTag: 5a3d9e99-905a-5c4f-aa09-f06a5464c81e
		summarizeBy: none
		sourceColumn: stage

		annotation SummarizationSetBy = Automatic

	column match_type
		dataType: string
		lineageTag: a53bdce1-0edf-52be-a64c-5135564bbb0f
		summarizeBy: none
		sourceColumn: match_type

		annotation SummarizationSetBy = Automatic

	column map
		dataType: string
		isHidden
		lineageTag: 1af10f1c-120b-5c75-86f6-265b30b763d1
		summarizeBy: none
		sourceColumn: map

		annotation SummarizationSetBy = Automatic

	column total_maps_played
		dataType: int64
		isHidden
		lineageTag: ccd44a00-b766-5819-bb73-e079ac7a01f0
		summarizeBy: sum
		sourceColumn: total_maps_played

		annotation SummarizationSetBy = Automatic

	column attacker_side_win_percentage
		dataType: double
		isHidden
		lineageTag: c9c09c85-81d3-55fe-b25e-66b652feeec5
		summarizeBy: sum
		sourceColumn: attacker_side_win_percentage

		annotation SummarizationSetBy = Automatic

	column defender_side_win_percentage
		dataType: double
		isHidden
		lineageTag: 26feb9a7-85a6-5e52-bff9-d9035c69a756
		summarizeBy: sum
		sourceColumn: defender_side_win_percentage

		annotation SummarizationSetBy = Automatic

	partition fact_map_stats = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_map_stats.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Selected Columns" = Table.SelectColumns(#"Promoted Headers", {"tournament", "stage", "match_type", "map", "total_maps_played", "attacker_side_win_percentage", "defender_side_win_percentage"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Selected Columns", {{"tournament", type text}, {"stage", type text}, {"match_type", type text}, {"map", type text}, {"total_maps_played", Int64.Type}, {"attacker_side_win_percentage", type number}, {"defender_side_win_percentage", type number}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table
