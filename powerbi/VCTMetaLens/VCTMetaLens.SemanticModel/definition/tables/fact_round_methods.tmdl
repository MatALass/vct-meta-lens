table fact_round_methods
	lineageTag: cca78f73-7e9f-5162-aea4-8877b426d4db

	measure 'Rounds gagnés' = CALCULATE ( COUNTROWS ( fact_round_methods ), fact_round_methods[outcome] = "Win" )
		formatString: #,0
		displayFolder: Maps
		lineageTag: fefd0c50-964b-5105-895c-668f00d5ee86

	measure 'Part des rounds gagnés %' = DIVIDE ( [Rounds gagnés], CALCULATE ( [Rounds gagnés], REMOVEFILTERS ( fact_round_methods[method] ) ) )
		formatString: 0.0%
		displayFolder: Maps
		lineageTag: 2c6113d5-5c67-5059-93d1-47251002ea97

