table fact_eco
	lineageTag: 021661e3-05f1-559c-893c-ebe8b6df1c67

	measure 'Rounds éco joués' = SUM ( fact_eco[initiated] )
		formatString: #,0
		displayFolder: Équipes
		lineageTag: 8182b93b-535a-5824-9883-40a452109e72

	measure 'Conversion éco %' = DIVIDE ( SUM ( fact_eco[won] ), SUM ( fact_eco[initiated] ) )
		formatString: 0.0%
		displayFolder: Équipes
		lineageTag: 88ac7a71-d3c2-5abb-8ce0-7661f0fb932c

	measure 'Pistols gagnés %' = CALCULATE ( [Conversion éco %], fact_eco[buy_category] = "Pistol" )
		formatString: 0.0%
		displayFolder: Équipes
		lineageTag: 6b2bed79-e0bb-5084-b88e-96fb68f6db8b

	column tournament
		dataType: string
		isHidden
		lineageTag: 0b12e6c6-1e9c-5241-aa03-32d52bef29d2
