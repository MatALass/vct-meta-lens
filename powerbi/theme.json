{
  "name": "VCT Meta Lens",
  "dataColors": [
    "#FF4655",
    "#0F1923",
    "#17A99B",
    "#E9C46A",
    "#7B5EA7",
    "#4F86C6",
    "#F28C38",
    "#8A9BA8"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F1923",
  "tableAccent": "#FF4655",
  "good": "#17A99B",
  "neutral": "#E9C46A",
  "bad": "#FF4655",
  "maximum": "#FF4655",
  "center": "#E9C46A",
  "minimum": "#ECE8E1",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F1923"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F1923"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F1923"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4A5560"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9D4CC"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F1923"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#ECE8E1"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#ECE8E1"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FF4655"
              }
            },
            "radius": 6
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F1923"
              }
            }
          }
        ]
      }
    }
  }
}
