table fact_player_map
	lineageTag: fec6dab6-bf2a-50e3-8947-779ddac9deb6

	measure 'Maps joueur' = COUNTROWS ( fact_player_map )
		formatString: #,0
		displayFolder: Joueurs
		lineageTag: 655f71cb-b745-559e-8195-21d322cb88ef

	measure 'Rating moyen' = AVERAGE ( fact_player_map[rating] )
		formatString: 0.00
		displayFolder: Joueurs
		lineageTag: 0a95b6db-ef21-52de-8470-1f1448ac57a7

	measure 'ACS moyen' = AVERAGE ( fact_player_map[average_combat_score] )
		formatString: 0
		displayFolder: Joueurs
		lineageTag: 255365ea-1971-55e9-a57f-aa4126ea4427

	measure 'ADR moyen' = AVERAGE ( fact_player_map[average_damage_per_round] )
		formatString: 0
		displayFolder: Joueurs
		lineageTag: 54196cc6-eeda-597e-9ecb-5a9aeba439bd

	measure 'K/D' = DIVIDE ( SUM ( fact_player_map[kills] ), SUM ( fact_player_map[deaths] ) )
		formatString: 0.00
		displayFolder: Joueurs
		lineageTag: 0a3ea437-b274-5fe2-8eed-c03e707fcf80

	measure 'FK/FD' = DIVIDE ( SUM ( fact_player_map[first_kills] ), SUM ( fact_player_map[first_deaths] ) )
		formatString: 0.00
		displayFolder: Joueurs
		lineageTag: 483e7fba-065d-5a5f-a8cb-23f67490e90a

	measure 'HS %' = AVERAGE ( fact_player_map[headshot_pct] ) / 100
		formatString: 0.0%
		displayFolder: Joueurs
		lineageTag: 5aeb49ae-d83e-54a2-a06f-e2907b3a20b0

	measure 'KAST %' = AVERAGE ( fact_player_map[kast_pct] ) / 100
		formatString: 0.0%
		displayFolder: Joueurs
		lineageTag: 56ba80e4-5701-5b8f-880d-d47d196435fa

	/// Vide sous 10 maps : évite qu'un remplaçant à 2 maps domine le classement.
	measure 'Rating (10 maps min.)' = IF ( [Maps joueur] >= 10, [Rating moyen] )
		formatString: 0.00
		displayFolder: Joueurs
		lineageTag: 44324a18-4b82-5444-93ff-30cf58a1e83f

	measure 'ACS (10 maps min.)' = IF ( [Maps joueur] >= 10, [ACS moyen] )
		formatString: 0
		displayFolder: Joueurs
		lineageTag: 2e87ca22-ab7c-5135-8351-603b44b2f244

